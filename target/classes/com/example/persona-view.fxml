<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.controller.PersonaController">

    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="15.0" right="15.0" bottom="5.0" left="15.0"/>
            </padding>
            <Label text="Gestion de Personas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <GridPane hgap="10.0" vgap="10.0">
                <Label text="Rol:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="rolCombo" prefWidth="240.0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Usuario:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="usuarioField" prefWidth="240.0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Correo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="correoField" prefWidth="240.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Edad:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="edadField" prefWidth="240.0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
            <HBox spacing="10.0">
                <Button text="Registrar" onAction="#onRegistrar"/>
                <Button text="Editar" onAction="#onEditar"/>
                <Button text="Eliminar" onAction="#onEliminar"/>
                <Button text="Limpiar" onAction="#onLimpiar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="personaTable" prefHeight="380.0" prefWidth="900.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="70.0"/>
                <TableColumn fx:id="rolColumn" text="Rol" prefWidth="180.0"/>
                <TableColumn fx:id="usuarioColumn" text="Usuario" prefWidth="160.0"/>
                <TableColumn fx:id="correoColumn" text="Correo" prefWidth="220.0"/>
                <TableColumn fx:id="edadColumn" text="Edad" prefWidth="130.0"/>
                <TableColumn fx:id="saldoColumn" text="Saldo" prefWidth="130.0"/>
            </columns>
            <BorderPane.margin>
                <Insets top="10.0" right="15.0" bottom="10.0" left="15.0"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <Label fx:id="mensajeLabel" text="" style="-fx-text-fill: #1f4f8a; -fx-font-size: 12px;">
            <BorderPane.margin>
                <Insets top="5.0" right="15.0" bottom="15.0" left="15.0"/>
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>
